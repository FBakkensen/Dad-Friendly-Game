rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: games (version 8 on, #558)
    // Document ID: Firebase Auth uid
    // Fields, the envelope only:
    //   - version: int >= 8, never lower than the stored one. A later
    //       build may raise it; an earlier build then reads the copy as
    //       newer and never writes over it.
    //   - rev: int. Create is rev 1; an update is exactly the stored rev + 1.
    //   - savedAt: timestamp, must be request.time
    //   - deviceId: string, 8..64
    //   - deviceLabel: optional string, 1..40
    //   - lastSeen: int >= 0 (epoch ms)
    //   - startedAt: optional int >= 0 (the run's start), never lower than
    //       the stored one, so a stale tab cannot write an older run back.
    //   - game: map. The client reads it and refuses what it cannot read
    //       (src/save-format.ts); the rules only require a map, so a new
    //       field never needs a rules change.
    //
    // Collection: gameArchive/{uid}/copies (version 8 on, #558)
    // A copy left behind, kept seven days: the side not chosen in a
    // conflict, the one a restore replaced, the one a Start over or a pass
    // left (#480), or a copy from before the current version (reason
    // 'reset'), kept as it was stored under `raw`.
    //
    // Collections saves and saveArchive: the saves from before version 8.
    // Readable by the owner, never written again.
    //
    // Collection: fieldLogs
    // Document ID: Firebase Auth uid (the account-wide log of builds before
    // #485), and fieldLogs/{uid}/devices/{deviceId} (one per device since).
    // Fields, the same in both:
    //   - snapshot: map (the field-log snapshot; no email or display name).
    //       Includes engineers (name, rank, post) and running expeditions
    //       (engineer, tunnel, returnsAt). Hazards are events only, never saved.
    //   - events: list of { at, code, data } (size <= 200)
    //   - updatedAt: int epoch ms
    // Snapshot mined and left are depth units (<= 240M). Snapshot pocket and
    // event stones are stones, which deep bands multiply: <= 10^15.
    // String caps and the 200-event cap keep the document under 50 KB.
    // Ownership is the document ID. No uid, role, or PII fields.
    //
    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasValidLastSeen(data) {
      return 'lastSeen' in data && data.lastSeen is int && data.lastSeen >= 0;
    }

    function isDeviceId(value) {
      return value is string && value.size() >= 8 && value.size() <= 64;
    }

    function isDeviceLabel(value) {
      return value is string && value.size() > 0 && value.size() <= 40;
    }

    function gameStart(data) {
      return data.get('startedAt', 0);
    }

    // The envelope this version writes. `game` is read by the client.
    function isGameEnvelope(data) {
      return data.version is int &&
        data.version >= 8 &&
        data.rev is int &&
        isDeviceId(data.deviceId) &&
        (!('deviceLabel' in data) || isDeviceLabel(data.deviceLabel)) &&
        hasValidLastSeen(data) &&
        (!('startedAt' in data) || (data.startedAt is int && data.startedAt >= 0)) &&
        data.game is map;
    }

    function isGame(data) {
      return data.keys().hasOnly(['version', 'rev', 'savedAt', 'deviceId', 'deviceLabel', 'lastSeen', 'startedAt', 'game']) &&
        data.savedAt == request.time &&
        isGameEnvelope(data);
    }

    function keptAWeek(data) {
      return data.archivedAt == request.time &&
        data.expiresAt is timestamp &&
        data.expiresAt > request.time + duration.value(7, 'd') - duration.value(5, 'm') &&
        data.expiresAt < request.time + duration.value(7, 'd') + duration.value(5, 'm');
    }

    function isGameArchive(data) {
      return data.reason in ['conflict', 'restore', 'start-over', 'pass', 'reset'] &&
        keptAWeek(data) &&
        data.rev is int &&
        data.rev >= 0 &&
        (data.reason == 'reset'
          ? data.keys().hasOnly(['version', 'rev', 'raw', 'archivedAt', 'expiresAt', 'reason']) &&
            data.version is int &&
            data.version >= 1 &&
            data.raw is map
          : data.keys().hasOnly(['version', 'rev', 'savedAt', 'deviceId', 'deviceLabel', 'lastSeen', 'startedAt', 'game', 'archivedAt', 'expiresAt', 'reason']) &&
            (!('savedAt' in data) || data.savedAt is timestamp) &&
            isGameEnvelope(data));
    }

    function isShortText(value) {
      return value is string && value.size() >= 1 && value.size() <= 24;
    }

    function isIsoText(value) {
      return value is string && value.size() >= 20 && value.size() <= 24;
    }

    function isFieldUpgrades(upgrades) {
      return upgrades is map &&
        upgrades.keys().hasOnly(['tap', 'boots', 'steady', 'cartSyn', 'drillSyn', 'borerSyn', 'machineSyn']) &&
        (!('tap' in upgrades) || (upgrades.tap is int && upgrades.tap >= 0 && upgrades.tap <= 10)) &&
        (!('boots' in upgrades) || (upgrades.boots is int && upgrades.boots >= 0 && upgrades.boots <= 1)) &&
        (!('steady' in upgrades) || (upgrades.steady is int && upgrades.steady >= 0 && upgrades.steady <= 1)) &&
        (!('cartSyn' in upgrades) || (upgrades.cartSyn is int && upgrades.cartSyn >= 0 && upgrades.cartSyn <= 1)) &&
        (!('drillSyn' in upgrades) || (upgrades.drillSyn is int && upgrades.drillSyn >= 0 && upgrades.drillSyn <= 1)) &&
        (!('borerSyn' in upgrades) || (upgrades.borerSyn is int && upgrades.borerSyn >= 0 && upgrades.borerSyn <= 1)) &&
        (!('machineSyn' in upgrades) || (upgrades.machineSyn is int && upgrades.machineSyn >= 0 && upgrades.machineSyn <= 1));
    }

    function isCrewCounts(crew) {
      return crew is map &&
        crew.keys().hasOnly(['helper', 'cart', 'drill', 'borer', 'machine', 'kid']) &&
        crew.keys().hasAll(['helper', 'cart', 'drill', 'borer', 'machine', 'kid']) &&
        crew.helper is int && crew.helper >= 0 && crew.helper <= 1000000 &&
        crew.cart is int && crew.cart >= 0 && crew.cart <= 1000000 &&
        crew.drill is int && crew.drill >= 0 && crew.drill <= 1000000 &&
        crew.borer is int && crew.borer >= 0 && crew.borer <= 1000000 &&
        crew.machine is int && crew.machine >= 0 && crew.machine <= 1000000 &&
        crew.kid is int && crew.kid >= 0 && crew.kid <= 1000000;
    }

    function isIdleCounts(idle) {
      return idle is map &&
        idle.keys().hasOnly(['cart', 'drill', 'borer', 'machine']) &&
        idle.keys().hasAll(['cart', 'drill', 'borer', 'machine']) &&
        idle.cart is int && idle.cart >= 0 && idle.cart <= 1000000 &&
        idle.drill is int && idle.drill >= 0 && idle.drill <= 1000000 &&
        idle.borer is int && idle.borer >= 0 && idle.borer <= 1000000 &&
        idle.machine is int && idle.machine >= 0 && idle.machine <= 1000000;
    }

    // Naming every relic, on top of a full snapshot, crosses the 1000-expression
    // budget once the shelf is full. The list is capped at 6. The client
    // writes the closed ids. A huge string still cannot blow the document up:
    // the client refuses a field log over 50 KB.
    function isRelicList(relics) {
      return relics is list && relics.size() <= 6;
    }

    function isFieldBoost(boost) {
      return boost is map &&
        boost.keys().hasOnly(['endsAt', 'id']) &&
        boost.id in ['sharper', 'overtime'] &&
        isIsoText(boost.endsAt);
    }

    // The second boost's shape, beside a full shelf and a full crew, crosses
    // the 1000-expression budget. The list is capped at 2. The first boost
    // carries the shape check.
    function isFieldBoostList(boosts) {
      return boosts is list && boosts.size() <= 2 &&
        (boosts.size() < 1 || isFieldBoost(boosts[0]));
    }

    // A full name/post/rank check, on top of the snapshot and the first event,
    // crosses the 1000-expression budget. The list is capped at 5. The first
    // hand must be a map of the three keys. The client writes the typed snapshot.
    function isFieldEngineers(engineers) {
      return engineers is list && engineers.size() <= 5 &&
        (engineers.size() < 1 || (
          engineers[0] is map &&
          engineers[0].keys().hasOnly(['name', 'post', 'rank'])
        ));
    }

    // Same budget. The list is capped at 5. The first trip must be a map of
    // who, which tunnel, and when they return.
    function isFieldTrips(trips) {
      return trips is list && trips.size() <= 5 &&
        (trips.size() < 1 || (
          trips[0] is map &&
          trips[0].keys().hasOnly(['engineer', 'returnsAt', 'tunnel'])
        ));
    }

    function isFieldSnapshot(shot) {
      return shot is map &&
        shot.keys().hasOnly(['at', 'boosts', 'crew', 'crewSpeed', 'deviceId', 'engineers', 'expeditions', 'idle', 'left', 'legacy', 'mined', 'pocket', 'relics', 'rev', 'tapYield', 'upgrades', 'version']) &&
        isIsoText(shot.at) &&
        shot.deviceId is string &&
        shot.rev is int &&
        isFieldBoostList(shot.boosts) &&
        isCrewCounts(shot.crew) &&
        shot.crewSpeed is number && shot.crewSpeed >= 0 && shot.crewSpeed <= 1000000000 &&
        (!('engineers' in shot) || isFieldEngineers(shot.engineers)) &&
        (!('expeditions' in shot) || isFieldTrips(shot.expeditions)) &&
        isIdleCounts(shot.idle) &&
        shot.left is int && shot.left >= 0 && shot.left <= 240000000 &&
        shot.legacy is int && shot.legacy >= 0 && shot.legacy <= 1000 &&
        shot.mined is int && shot.mined >= 0 && shot.mined <= 240000000 &&
        shot.pocket is int && shot.pocket >= 0 && shot.pocket <= 1000000000000000 &&
        isRelicList(shot.relics) &&
        shot.tapYield is number && shot.tapYield >= 0 && shot.tapYield <= 1000000000 &&
        isFieldUpgrades(shot.upgrades) &&
        isShortText(shot.version);
    }

    // A full check of every event, on top of the snapshot, exceeds the rules
    // engine's 1000-expression budget. The list is capped at 200. The first
    // event carries the shape check. The client refuses a document over 50 KB.
    function dataOk(eventData) {
      return eventData.size() <= 2 &&
        eventData.keys().hasOnly(['count', 'endsAt', 'id', 'ms', 'source', 'stones']) &&
        (!('id' in eventData) || isShortText(eventData.id)) &&
        (!('endsAt' in eventData) || isIsoText(eventData.endsAt)) &&
        (!('source' in eventData) || isShortText(eventData.source)) &&
        (!('count' in eventData) || (eventData.count is int && eventData.count >= 0 && eventData.count <= 1000000)) &&
        (!('ms' in eventData) || (eventData.ms is int && eventData.ms >= 0)) &&
        (!('stones' in eventData) || (eventData.stones is number && eventData.stones >= 0 && eventData.stones <= 1000000000000000));
    }

    function eventOk(event) {
      return event.keys().hasOnly(['at', 'code', 'data']) &&
        isIsoText(event.at) &&
        isShortText(event.code) &&
        dataOk(event.data);
    }

    function eventsOk(events) {
      return events is list &&
        events.size() <= 200 &&
        (events.size() < 1 || eventOk(events[0]));
    }

    function isFieldLog(data) {
      return data.keys().hasOnly(['events', 'snapshot', 'updatedAt']) &&
        isFieldSnapshot(data.snapshot) &&
        eventsOk(data.events) &&
        data.updatedAt is int &&
        data.updatedAt >= 0;
    }

    match /games/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        request.resource.data.rev == 1 &&
        isGame(request.resource.data);
      // The rev compare is first, so a stale write stays cheap.
      allow update: if isOwner(userId) &&
        request.resource.data.rev == resource.data.get('rev', 0) + 1 &&
        isGame(request.resource.data) &&
        request.resource.data.version >= resource.data.version &&
        gameStart(request.resource.data) >= gameStart(resource.data);
      allow delete: if false;
    }

    // Seven days is shown in the client. Nothing here deletes an expired copy.
    match /gameArchive/{userId}/copies/{copyId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isGameArchive(request.resource.data);
      allow update, delete: if false;
    }

    // The saves from before version 8 (#558): still readable, never written.
    match /saves/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /saveArchive/{userId}/copies/{copyId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // The account-wide log builds before #485 wrote. Still writable, so a
    // cached older build uploads without an error.
    match /fieldLogs/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isFieldLog(request.resource.data);
      allow delete: if false;
    }

    // One log per device (#485): the phone and the PC never overwrite each
    // other. The id is the device id the save carries, 8 to 64 characters.
    match /fieldLogs/{userId}/devices/{deviceId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
        deviceId.size() >= 8 &&
        deviceId.size() <= 64 &&
        isFieldLog(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
