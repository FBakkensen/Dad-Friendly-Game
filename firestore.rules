rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: saves
    // Document ID: Firebase Auth uid
    // Fields:
    //   - version: int (required, 1..5)
    //   - mountain: map (required iff version is 3, 4, or 5)
    //       - remaining: int 0..240000000 (v4: 0..100000000, v3: 0..1000000), pocket: int >= 0, helpers: int >= 0, carts, drills, borers, machines, kids: optional int >= 0, upgrades: optional map of known ids to int levels, boosts: optional map of known ids to int end times,
    //         startedAt: optional int >= 0 (run start; updates may not lower it)
    //         staffed: optional true or 1 (#89 grant) or 2 (M7 top-up). true stays valid for old clients.
    //         engineers: optional list, size 0..5. Each: name from the closed list, rank 0..2 matching trips (0 until 3, 1 until 9, then 2), trips 0..1000000, post a machine tier or camp or tunnel. Names unique.
    //         expeditions: optional list, size 0..5. The first two trips must use a closed tunnel id, and returnsAt must be later than sentAt by at most 4 hours. The client parser checks the rest of the shape.
    //         finds: optional list of lost-tool and keepsake ids, size 0..9. The client parser rejects duplicates.
    //   - grid: map (required iff version is 1 or 2; legacy, read-migrated by the client)
    //       - width: int (required, must be 3)
    //       - height: int (required, must be 3)
    //       - cells: list (required, size 9)
    //           - kind: string (required, 'covered', 'dug', 'stone', or 'chunk')
    //   - lastSeen: int (required iff version >= 2; epoch ms)
    //
    // Collection: fieldLogs
    // Document ID: Firebase Auth uid
    // Fields:
    //   - snapshot: map (the field-log snapshot; no email or display name).
    //       Includes engineers (name, rank, post) and running expeditions
    //       (engineer, tunnel, returnsAt). Hazards are events only, never saved.
    //   - events: list of { at, code, data } (size <= 200)
    //   - updatedAt: int epoch ms
    // String caps and the 200-event cap keep the document under 50 KB.
    // Ownership is the document ID. No uid, role, or PII fields.
    //
    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidCell(cell) {
      return cell is map &&
        cell.keys().hasOnly(['kind']) &&
        cell.kind is string &&
        cell.kind in ['covered', 'dug', 'stone', 'chunk'];
    }

    function isValidGrid(grid) {
      return grid is map &&
        grid.keys().hasOnly(['width', 'height', 'cells']) &&
        grid.width is int &&
        grid.width == 3 &&
        grid.height is int &&
        grid.height == 3 &&
        grid.cells is list &&
        grid.cells.size() == 9 &&
        isValidCell(grid.cells[0]) &&
        isValidCell(grid.cells[1]) &&
        isValidCell(grid.cells[2]) &&
        isValidCell(grid.cells[3]) &&
        isValidCell(grid.cells[4]) &&
        isValidCell(grid.cells[5]) &&
        isValidCell(grid.cells[6]) &&
        isValidCell(grid.cells[7]) &&
        isValidCell(grid.cells[8]);
    }

    function isEngineer(engineer) {
      return engineer.keys().hasOnly(['name', 'rank', 'trips', 'post']) &&
        engineer.name in ['Ada', 'Nils', 'Ruth', 'Otto', 'Mae'] &&
        engineer.post in ['cart', 'drill', 'borer', 'machine', 'camp', 'tunnel'] &&
        engineer.trips is int &&
        engineer.trips >= 0 &&
        engineer.trips <= 1000000 &&
        engineer.rank == (engineer.trips >= 9 ? 2 : (engineer.trips >= 3 ? 1 : 0));
    }

    function isValidEngineers(engineers) {
      return engineers is list && engineers.size() <= 5 &&
        (engineers.size() < 1 || isEngineer(engineers[0])) &&
        (engineers.size() < 2 || (isEngineer(engineers[1]) && engineers[1].name != engineers[0].name)) &&
        (engineers.size() < 3 || (isEngineer(engineers[2]) && engineers[2].name != engineers[0].name && engineers[2].name != engineers[1].name)) &&
        (engineers.size() < 4 || (isEngineer(engineers[3]) && engineers[3].name != engineers[0].name && engineers[3].name != engineers[1].name && engineers[3].name != engineers[2].name)) &&
        (engineers.size() < 5 || (isEngineer(engineers[4]) && engineers[4].name != engineers[0].name && engineers[4].name != engineers[1].name && engineers[4].name != engineers[2].name && engineers[4].name != engineers[3].name));
    }

    function tripTimesOk(trip) {
      return (trip.tunnel == 'side-seam' || trip.tunnel == 'old-shaft' || trip.tunnel == 'deep-dark') &&
        trip.returnsAt > trip.sentAt &&
        trip.returnsAt - trip.sentAt <= 14400000;
    }

    // Shape-checking every trip, on top of five engineers, crosses the
    // 1000-expression budget. The list is capped at 5. The first two trips
    // carry the tunnel and the return time. Home, the leader, and the find
    // are checked by the client parser, which rejects a corrupt save.
    function isValidExpeditions(expeditions) {
      return expeditions is list && expeditions.size() <= 5 &&
        (expeditions.size() < 1 || tripTimesOk(expeditions[0])) &&
        (expeditions.size() < 2 || tripTimesOk(expeditions[1]));
    }

    // Duplicate ids are rejected by the parser. Pairwise checks here, beside a
    // full crew, cross the 1000-expression budget. hasOnly keeps the ids closed.
    function isValidFinds(finds) {
      return finds is list &&
        finds.size() <= 9 &&
        finds.hasOnly(['pick', 'lamp', 'map', 'boots', 'drawing', 'watch', 'whistle', 'pebble', 'ribbon']);
    }

    function isValidMountain(mountain, total) {
      return mountain is map &&
        mountain.keys().hasAll(['remaining', 'pocket', 'helpers']) &&
        mountain.keys().hasOnly(['remaining', 'pocket', 'helpers', 'carts', 'drills', 'borers', 'machines', 'kids', 'upgrades', 'boosts', 'startedAt', 'staffed', 'legacy', 'engineers', 'expeditions', 'finds']) &&
        mountain.remaining is int &&
        mountain.remaining >= 0 &&
        mountain.remaining <= total &&
        mountain.pocket is int &&
        mountain.pocket >= 0 &&
        mountain.helpers is int &&
        mountain.helpers >= 0 &&
        (!('carts' in mountain) || (mountain.carts is int && mountain.carts >= 0)) &&
        (!('drills' in mountain) || (mountain.drills is int && mountain.drills >= 0)) &&
        (!('borers' in mountain) || (mountain.borers is int && mountain.borers >= 0)) &&
        (!('machines' in mountain) || (mountain.machines is int && mountain.machines >= 0)) &&
        (!('kids' in mountain) || (mountain.kids is int && mountain.kids >= 0)) &&
        (!('upgrades' in mountain) || (mountain.upgrades is map &&
          mountain.upgrades.keys().hasOnly(['tap', 'boots', 'steady', 'cartSyn', 'drillSyn', 'borerSyn', 'machineSyn']) &&
          (!('tap' in mountain.upgrades) || (mountain.upgrades.tap is int && mountain.upgrades.tap >= 0 && mountain.upgrades.tap <= 10)) &&
          (!('boots' in mountain.upgrades) || (mountain.upgrades.boots is int && mountain.upgrades.boots >= 0 && mountain.upgrades.boots <= 1)) &&
          (!('steady' in mountain.upgrades) || (mountain.upgrades.steady is int && mountain.upgrades.steady >= 0 && mountain.upgrades.steady <= 1)) &&
          (!('cartSyn' in mountain.upgrades) || (mountain.upgrades.cartSyn is int && mountain.upgrades.cartSyn >= 0 && mountain.upgrades.cartSyn <= 1)) &&
          (!('drillSyn' in mountain.upgrades) || (mountain.upgrades.drillSyn is int && mountain.upgrades.drillSyn >= 0 && mountain.upgrades.drillSyn <= 1)) &&
          (!('borerSyn' in mountain.upgrades) || (mountain.upgrades.borerSyn is int && mountain.upgrades.borerSyn >= 0 && mountain.upgrades.borerSyn <= 1)) &&
          (!('machineSyn' in mountain.upgrades) || (mountain.upgrades.machineSyn is int && mountain.upgrades.machineSyn >= 0 && mountain.upgrades.machineSyn <= 1)))) &&
        (!('boosts' in mountain) || (mountain.boosts is map &&
          mountain.boosts.keys().hasOnly(['sharper', 'overtime']) &&
          (!('sharper' in mountain.boosts) || (mountain.boosts.sharper is int && mountain.boosts.sharper >= 0)) &&
          (!('overtime' in mountain.boosts) || (mountain.boosts.overtime is int && mountain.boosts.overtime >= 0)))) &&
        (!('startedAt' in mountain) || (mountain.startedAt is int && mountain.startedAt >= 0)) &&
        (!('staffed' in mountain) || mountain.staffed == true || mountain.staffed == 1 || mountain.staffed == 2) &&
        (!('legacy' in mountain) || (mountain.legacy is int && mountain.legacy >= 0 && mountain.legacy <= 1000)) &&
        (!('engineers' in mountain) || isValidEngineers(mountain.engineers)) &&
        (!('expeditions' in mountain) || isValidExpeditions(mountain.expeditions)) &&
        (!('finds' in mountain) || isValidFinds(mountain.finds));
    }

    function runStart(data) {
      return data.get('mountain', {}).get('startedAt', 0);
    }

    // "Start over" begins a newer run; a stale tab can't write an older run back.
    function notOlderRun() {
      return runStart(request.resource.data) >= runStart(resource.data);
    }

    function hasValidLastSeen(data) {
      return 'lastSeen' in data && data.lastSeen is int && data.lastSeen >= 0;
    }

    function isValidSave(data) {
      return uidUnchanged() &&
        data.version is int &&
        (
          (data.version == 5 &&
            hasOnlyAllowedFields(['version', 'mountain', 'lastSeen']) &&
            hasValidLastSeen(data) &&
            isValidMountain(data.mountain, 240000000)) ||
          (data.version == 4 &&
            hasOnlyAllowedFields(['version', 'mountain', 'lastSeen']) &&
            hasValidLastSeen(data) &&
            isValidMountain(data.mountain, 100000000)) ||
          (data.version == 3 &&
            hasOnlyAllowedFields(['version', 'mountain', 'lastSeen']) &&
            hasValidLastSeen(data) &&
            isValidMountain(data.mountain, 1000000)) ||
          (data.version == 2 &&
            hasOnlyAllowedFields(['version', 'grid', 'lastSeen']) &&
            hasValidLastSeen(data) &&
            isValidGrid(data.grid)) ||
          (data.version == 1 &&
            hasOnlyAllowedFields(['version', 'grid']) &&
            isValidGrid(data.grid))
        );
    }

    function isShortText(value) {
      return value is string && value.size() >= 1 && value.size() <= 24;
    }

    function isIsoText(value) {
      return value is string && value.size() >= 20 && value.size() <= 24;
    }

    function isFieldUpgrades(upgrades) {
      return upgrades is map &&
        upgrades.keys().hasOnly(['tap', 'boots', 'steady', 'cartSyn', 'drillSyn', 'borerSyn', 'machineSyn']) &&
        (!('tap' in upgrades) || (upgrades.tap is int && upgrades.tap >= 0 && upgrades.tap <= 10)) &&
        (!('boots' in upgrades) || (upgrades.boots is int && upgrades.boots >= 0 && upgrades.boots <= 1)) &&
        (!('steady' in upgrades) || (upgrades.steady is int && upgrades.steady >= 0 && upgrades.steady <= 1)) &&
        (!('cartSyn' in upgrades) || (upgrades.cartSyn is int && upgrades.cartSyn >= 0 && upgrades.cartSyn <= 1)) &&
        (!('drillSyn' in upgrades) || (upgrades.drillSyn is int && upgrades.drillSyn >= 0 && upgrades.drillSyn <= 1)) &&
        (!('borerSyn' in upgrades) || (upgrades.borerSyn is int && upgrades.borerSyn >= 0 && upgrades.borerSyn <= 1)) &&
        (!('machineSyn' in upgrades) || (upgrades.machineSyn is int && upgrades.machineSyn >= 0 && upgrades.machineSyn <= 1));
    }

    function isCrewCounts(crew) {
      return crew is map &&
        crew.keys().hasOnly(['helper', 'cart', 'drill', 'borer', 'machine', 'kid']) &&
        crew.keys().hasAll(['helper', 'cart', 'drill', 'borer', 'machine', 'kid']) &&
        crew.helper is int && crew.helper >= 0 && crew.helper <= 1000000 &&
        crew.cart is int && crew.cart >= 0 && crew.cart <= 1000000 &&
        crew.drill is int && crew.drill >= 0 && crew.drill <= 1000000 &&
        crew.borer is int && crew.borer >= 0 && crew.borer <= 1000000 &&
        crew.machine is int && crew.machine >= 0 && crew.machine <= 1000000 &&
        crew.kid is int && crew.kid >= 0 && crew.kid <= 1000000;
    }

    function isIdleCounts(idle) {
      return idle is map &&
        idle.keys().hasOnly(['cart', 'drill', 'borer', 'machine']) &&
        idle.keys().hasAll(['cart', 'drill', 'borer', 'machine']) &&
        idle.cart is int && idle.cart >= 0 && idle.cart <= 1000000 &&
        idle.drill is int && idle.drill >= 0 && idle.drill <= 1000000 &&
        idle.borer is int && idle.borer >= 0 && idle.borer <= 1000000 &&
        idle.machine is int && idle.machine >= 0 && idle.machine <= 1000000;
    }

    function isRelicId(id) {
      return id is string && id in ['lantern', 'shield', 'hammer', 'heart', 'crown', 'mantle'];
    }

    function isRelicList(relics) {
      return relics is list && relics.size() <= 6 &&
        (relics.size() < 1 || isRelicId(relics[0])) &&
        (relics.size() < 2 || isRelicId(relics[1])) &&
        (relics.size() < 3 || isRelicId(relics[2])) &&
        (relics.size() < 4 || isRelicId(relics[3])) &&
        (relics.size() < 5 || isRelicId(relics[4])) &&
        (relics.size() < 6 || isRelicId(relics[5]));
    }

    function isFieldBoost(boost) {
      return boost is map &&
        boost.keys().hasOnly(['endsAt', 'id']) &&
        boost.id in ['sharper', 'overtime'] &&
        isIsoText(boost.endsAt);
    }

    function isFieldBoostList(boosts) {
      return boosts is list && boosts.size() <= 2 &&
        (boosts.size() < 1 || isFieldBoost(boosts[0])) &&
        (boosts.size() < 2 || isFieldBoost(boosts[1]));
    }

    // A full name/post/rank check, on top of the snapshot and the first event,
    // crosses the 1000-expression budget. The list is capped at 5. The first
    // hand must be a map of the three keys. The client writes the typed snapshot.
    function isFieldEngineers(engineers) {
      return engineers is list && engineers.size() <= 5 &&
        (engineers.size() < 1 || (
          engineers[0] is map &&
          engineers[0].keys().hasOnly(['name', 'post', 'rank'])
        ));
    }

    // Same budget. The list is capped at 5. The first trip must be a map of
    // who, which tunnel, and when they return.
    function isFieldTrips(trips) {
      return trips is list && trips.size() <= 5 &&
        (trips.size() < 1 || (
          trips[0] is map &&
          trips[0].keys().hasOnly(['engineer', 'returnsAt', 'tunnel'])
        ));
    }

    function isFieldSnapshot(shot) {
      return shot is map &&
        shot.keys().hasOnly(['at', 'boosts', 'crew', 'crewSpeed', 'engineers', 'expeditions', 'idle', 'left', 'legacy', 'mined', 'pocket', 'relics', 'tapYield', 'upgrades', 'version']) &&
        isIsoText(shot.at) &&
        isFieldBoostList(shot.boosts) &&
        isCrewCounts(shot.crew) &&
        shot.crewSpeed is number && shot.crewSpeed >= 0 && shot.crewSpeed <= 1000000000 &&
        (!('engineers' in shot) || isFieldEngineers(shot.engineers)) &&
        (!('expeditions' in shot) || isFieldTrips(shot.expeditions)) &&
        isIdleCounts(shot.idle) &&
        shot.left is int && shot.left >= 0 && shot.left <= 240000000 &&
        shot.legacy is int && shot.legacy >= 0 && shot.legacy <= 1000 &&
        shot.mined is int && shot.mined >= 0 && shot.mined <= 240000000 &&
        shot.pocket is int && shot.pocket >= 0 && shot.pocket <= 240000000 &&
        isRelicList(shot.relics) &&
        shot.tapYield is number && shot.tapYield >= 0 && shot.tapYield <= 1000000000 &&
        isFieldUpgrades(shot.upgrades) &&
        isShortText(shot.version);
    }

    // A full check of every event, on top of the snapshot, exceeds the rules
    // engine's 1000-expression budget. The list is capped at 200. The first
    // event carries the shape check. The client refuses a document over 50 KB.
    function dataOk(eventData) {
      return eventData.size() <= 2 &&
        eventData.keys().hasOnly(['count', 'endsAt', 'id', 'ms', 'source', 'stones']) &&
        (!('id' in eventData) || isShortText(eventData.id)) &&
        (!('endsAt' in eventData) || isIsoText(eventData.endsAt)) &&
        (!('source' in eventData) || isShortText(eventData.source)) &&
        (!('count' in eventData) || (eventData.count is int && eventData.count >= 0 && eventData.count <= 1000000)) &&
        (!('ms' in eventData) || (eventData.ms is int && eventData.ms >= 0)) &&
        (!('stones' in eventData) || (eventData.stones is number && eventData.stones >= 0 && eventData.stones <= 240000000));
    }

    function eventOk(event) {
      return event.keys().hasOnly(['at', 'code', 'data']) &&
        isIsoText(event.at) &&
        isShortText(event.code) &&
        dataOk(event.data);
    }

    function eventsOk(events) {
      return events is list &&
        events.size() <= 200 &&
        (events.size() < 1 || eventOk(events[0]));
    }

    function isFieldLog(data) {
      return data.keys().hasOnly(['events', 'snapshot', 'updatedAt']) &&
        isFieldSnapshot(data.snapshot) &&
        eventsOk(data.events) &&
        data.updatedAt is int &&
        data.updatedAt >= 0;
    }

    match /saves/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidSave(request.resource.data);
      allow update: if isOwner(userId) &&
        isValidSave(request.resource.data) &&
        uidNotModified() &&
        notOlderRun();
      allow delete: if false;
    }

    match /fieldLogs/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && isFieldLog(request.resource.data);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
