rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: saves
    // Document ID: Firebase Auth uid
    // Fields:
    //   - version: int (required, 1, 2, or 3)
    //   - mountain: map (required iff version == 3)
    //       - remaining: int 0..1000000, pocket: int >= 0, helpers: int >= 0
    //   - grid: map (required iff version is 1 or 2; legacy, read-migrated by the client)
    //       - width: int (required, must be 3)
    //       - height: int (required, must be 3)
    //       - cells: list (required, size 9)
    //           - kind: string (required, 'covered', 'dug', 'stone', or 'chunk')
    //   - lastSeen: int (required iff version is 2 or 3; epoch ms)
    // Ownership is the document ID. No uid, role, or PII fields.
    //
    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidCell(cell) {
      return cell is map &&
        cell.keys().hasOnly(['kind']) &&
        cell.kind is string &&
        cell.kind in ['covered', 'dug', 'stone', 'chunk'];
    }

    function isValidGrid(grid) {
      return grid is map &&
        grid.keys().hasOnly(['width', 'height', 'cells']) &&
        grid.width is int &&
        grid.width == 3 &&
        grid.height is int &&
        grid.height == 3 &&
        grid.cells is list &&
        grid.cells.size() == 9 &&
        isValidCell(grid.cells[0]) &&
        isValidCell(grid.cells[1]) &&
        isValidCell(grid.cells[2]) &&
        isValidCell(grid.cells[3]) &&
        isValidCell(grid.cells[4]) &&
        isValidCell(grid.cells[5]) &&
        isValidCell(grid.cells[6]) &&
        isValidCell(grid.cells[7]) &&
        isValidCell(grid.cells[8]);
    }

    function isValidMountain(mountain) {
      return mountain is map &&
        mountain.keys().hasOnly(['remaining', 'pocket', 'helpers']) &&
        mountain.remaining is int &&
        mountain.remaining >= 0 &&
        mountain.remaining <= 1000000 &&
        mountain.pocket is int &&
        mountain.pocket >= 0 &&
        mountain.helpers is int &&
        mountain.helpers >= 0;
    }

    function hasValidLastSeen(data) {
      return 'lastSeen' in data && data.lastSeen is int && data.lastSeen >= 0;
    }

    function isValidSave(data) {
      return uidUnchanged() &&
        data.version is int &&
        (
          (data.version == 3 &&
            hasOnlyAllowedFields(['version', 'mountain', 'lastSeen']) &&
            hasValidLastSeen(data) &&
            isValidMountain(data.mountain)) ||
          (data.version == 2 &&
            hasOnlyAllowedFields(['version', 'grid', 'lastSeen']) &&
            hasValidLastSeen(data) &&
            isValidGrid(data.grid)) ||
          (data.version == 1 &&
            hasOnlyAllowedFields(['version', 'grid']) &&
            isValidGrid(data.grid))
        );
    }

    match /saves/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidSave(request.resource.data);
      allow update: if isOwner(userId) &&
        isValidSave(request.resource.data) &&
        uidNotModified();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
