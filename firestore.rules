rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: saves
    // Document ID: Firebase Auth uid
    // Fields:
    //   - version: int (required, 1..4)
    //   - mountain: map (required iff version is 3 or 4)
    //       - remaining: int 0..100000000 (v3: 0..1000000), pocket: int >= 0, helpers: int >= 0, carts, drills, borers, machines: optional int >= 0,
    //         startedAt: optional int >= 0 (run start; updates may not lower it)
    //   - grid: map (required iff version is 1 or 2; legacy, read-migrated by the client)
    //       - width: int (required, must be 3)
    //       - height: int (required, must be 3)
    //       - cells: list (required, size 9)
    //           - kind: string (required, 'covered', 'dug', 'stone', or 'chunk')
    //   - lastSeen: int (required iff version >= 2; epoch ms)
    // Ownership is the document ID. No uid, role, or PII fields.
    //
    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function isValidCell(cell) {
      return cell is map &&
        cell.keys().hasOnly(['kind']) &&
        cell.kind is string &&
        cell.kind in ['covered', 'dug', 'stone', 'chunk'];
    }

    function isValidGrid(grid) {
      return grid is map &&
        grid.keys().hasOnly(['width', 'height', 'cells']) &&
        grid.width is int &&
        grid.width == 3 &&
        grid.height is int &&
        grid.height == 3 &&
        grid.cells is list &&
        grid.cells.size() == 9 &&
        isValidCell(grid.cells[0]) &&
        isValidCell(grid.cells[1]) &&
        isValidCell(grid.cells[2]) &&
        isValidCell(grid.cells[3]) &&
        isValidCell(grid.cells[4]) &&
        isValidCell(grid.cells[5]) &&
        isValidCell(grid.cells[6]) &&
        isValidCell(grid.cells[7]) &&
        isValidCell(grid.cells[8]);
    }

    function isValidMountain(mountain, total) {
      return mountain is map &&
        mountain.keys().hasAll(['remaining', 'pocket', 'helpers']) &&
        mountain.keys().hasOnly(['remaining', 'pocket', 'helpers', 'carts', 'drills', 'borers', 'machines', 'startedAt']) &&
        mountain.remaining is int &&
        mountain.remaining >= 0 &&
        mountain.remaining <= total &&
        mountain.pocket is int &&
        mountain.pocket >= 0 &&
        mountain.helpers is int &&
        mountain.helpers >= 0 &&
        (!('carts' in mountain) || (mountain.carts is int && mountain.carts >= 0)) &&
        (!('drills' in mountain) || (mountain.drills is int && mountain.drills >= 0)) &&
        (!('borers' in mountain) || (mountain.borers is int && mountain.borers >= 0)) &&
        (!('machines' in mountain) || (mountain.machines is int && mountain.machines >= 0)) &&
        (!('startedAt' in mountain) || (mountain.startedAt is int && mountain.startedAt >= 0));
    }

    function runStart(data) {
      return data.get('mountain', {}).get('startedAt', 0);
    }

    // "Start over" begins a newer run; a stale tab can't write an older run back.
    function notOlderRun() {
      return runStart(request.resource.data) >= runStart(resource.data);
    }

    function hasValidLastSeen(data) {
      return 'lastSeen' in data && data.lastSeen is int && data.lastSeen >= 0;
    }

    function isValidSave(data) {
      return uidUnchanged() &&
        data.version is int &&
        (
          (data.version == 4 &&
            hasOnlyAllowedFields(['version', 'mountain', 'lastSeen']) &&
            hasValidLastSeen(data) &&
            isValidMountain(data.mountain, 100000000)) ||
          (data.version == 3 &&
            hasOnlyAllowedFields(['version', 'mountain', 'lastSeen']) &&
            hasValidLastSeen(data) &&
            isValidMountain(data.mountain, 1000000)) ||
          (data.version == 2 &&
            hasOnlyAllowedFields(['version', 'grid', 'lastSeen']) &&
            hasValidLastSeen(data) &&
            isValidGrid(data.grid)) ||
          (data.version == 1 &&
            hasOnlyAllowedFields(['version', 'grid']) &&
            isValidGrid(data.grid))
        );
    }

    match /saves/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidSave(request.resource.data);
      allow update: if isOwner(userId) &&
        isValidSave(request.resource.data) &&
        uidNotModified() &&
        notOlderRun();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
