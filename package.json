{
  "name": "dad-friendly-game",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "field-log": "node tools/field-log.ts",
    "lab": "node --import ./tools/lab-register.mjs tools/strategy-lab.ts",
    "lab:ledger": "node --import ./tools/lab-register.mjs tools/strategy-lab.ts --ci --ledger write",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile .gate/app.tsbuildinfo && tsc --noEmit --incremental --tsBuildInfoFile .gate/tools.tsbuildinfo -p tools/tsconfig.json",
    "lint": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "node scripts/knip-strict.js",
    "tokens": "node scripts/token-check.mjs",
    "functions": "node scripts/function-limits.mjs",
    "cycles": "node scripts/check-cycles.mjs",
    "gate": "node scripts/gate.mjs",
    "check": "node scripts/gate.mjs full",
    "check:fast": "node scripts/gate.mjs fast",
    "visual": "node scripts/visual-check.mjs",
    "play": "node scripts/play.mjs",
    "journeys": "playwright test -c tools/journeys",
    "audit:ui": "node scripts/ui-audit.mjs",
    "mockups": "node scripts/mockup-check.mjs",
    "test:rules": "node scripts/test-rules.mjs",
    "env:report": "node scripts/env-report.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.65.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "fast-check": "4.10.2",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.36.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.45.1",
    "prettier": "^3.10.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "firebase": "^12.17.1"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "^1.14.7"
    },
    "minimatch@>=7.0.0 <11.0.1": "^11.0.8",
    "uuid@<11.1.1": "^11.1.1"
  }
}
