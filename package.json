{
  "name": "dad-friendly-game",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "field-log": "node tools/field-log.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools/tsconfig.json",
    "lint": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "node scripts/knip-strict.js",
    "cycles": "node scripts/check-cycles.mjs",
    "check": "node scripts/env-report.mjs --strict && npm run typecheck && npm run lint && npm run cycles && npm run format:check && npm run knip && npm run coverage && npm run test:rules && npm run visual",
    "visual": "node scripts/visual-check.mjs",
    "test:rules": "node scripts/test-rules.mjs",
    "env:report": "node scripts/env-report.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.33.0",
    "happy-dom": "^20.11.2",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "firebase": "^12.17.1"
  }
}
